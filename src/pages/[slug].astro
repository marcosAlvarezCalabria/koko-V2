---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Footer } from "@/components/Footer";
import { Header } from "@/components/Header";
import { businessInfo } from "@/data/site";
import { servicePages, type ServicePage } from "@/data/servicePages";
import { buildWhatsappUrl } from "@/lib/contact/buildWhatsappUrl";

export function getStaticPaths() {
  return servicePages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

interface Props {
  page: ServicePage;
}

const { page } = Astro.props;
const otherServices = servicePages.filter(({ slug }) => slug !== page.slug);
const telephoneHref = `tel:${businessInfo.telephone.replace(/\s/g, "")}`;
const whatsappUrl = buildWhatsappUrl(
  businessInfo.telephone,
  `Hello Koko Atelier, I would like to ask about ${page.shortName.toLowerCase()}.`
);
---

<BaseLayout title={page.title} description={page.description}>
  <Header />

  <main>
    <section class="overflow-hidden bg-brand-900 text-white">
      <div class="container-page py-6 md:py-8">
        <nav aria-label="Breadcrumb" class="text-sm text-blue-100">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a class="hover:text-white" href="/">Home</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">{page.shortName}</li>
          </ol>
        </nav>
      </div>

      <div class="container-page grid items-center gap-10 pb-16 pt-6 md:grid-cols-[1.05fr_0.95fr] md:pb-24 md:pt-10">
        <div>
          <p class="text-sm font-semibold text-blue-200">Koko Atelier - Galway city</p>
          <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-balance md:text-6xl">
            {page.heading}
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-blue-50">
            {page.intro[0]}
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="inline-flex min-h-12 items-center rounded-xl bg-white px-5 py-3 font-semibold text-brand-900 hover:bg-blue-50" href={whatsappUrl}>
              Ask about your garment
            </a>
            <a class="inline-flex min-h-12 items-center rounded-xl border border-blue-300/60 px-5 py-3 font-semibold text-white hover:bg-white/10" href={telephoneHref}>
              Call {businessInfo.telephone}
            </a>
          </div>
        </div>

        <figure class="relative min-h-[22rem] overflow-hidden rounded-2xl bg-brand-700 md:min-h-[34rem]">
          <img
            src={page.image}
            alt={page.imageAlt}
            class="absolute inset-0 h-full w-full object-cover"
            width="900"
            height="1080"
            fetchpriority="high"
          />
        </figure>
      </div>
    </section>

    <section class="section-padding">
      <div class="container-page grid gap-12 md:grid-cols-[0.9fr_1.1fr] md:gap-20">
        <div>
          <p class="text-sm font-semibold text-brand-700">Personal assessment</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-brand-900 md:text-4xl">
            Start with the garment and the way you want it to fit
          </h2>
        </div>
        <div class="max-w-3xl space-y-5 text-lg leading-8 text-slate-700">
          <p>{page.intro[1]}</p>
          <p>
            Every alteration begins with the garment in front of us. Fabric, seam allowance,
            lining and original construction affect the available options, so final prices and
            timing are confirmed after assessment.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-slate-50 section-padding">
      <div class="container-page grid gap-12 md:grid-cols-2 md:gap-20">
        <div>
          <p class="text-sm font-semibold text-brand-700">Alterations</p>
          <h2 class="mt-3 text-3xl font-semibold text-brand-900 md:text-4xl">What we can help with</h2>
          <ul class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
            {page.services.map((service) => (
              <li class="flex items-center gap-3 py-4 text-lg">
                <span class="h-2 w-2 rounded-full bg-brand-600" aria-hidden="true"></span>
                {service}
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl bg-white p-7 md:p-10">
          <p class="text-sm font-semibold text-brand-700">Before you visit</p>
          <h2 class="mt-3 text-3xl font-semibold text-brand-900">Prepare for your fitting</h2>
          <ol class="mt-8 space-y-6">
            {page.preparation.map((item, index) => (
              <li class="grid grid-cols-[2rem_1fr] gap-4">
                <span class="font-semibold text-brand-700">{String(index + 1).padStart(2, "0")}</span>
                <span class="leading-7 text-slate-700">{item}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="section-padding">
      <div class="container-page grid gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
        <div>
          <p class="text-sm font-semibold text-brand-700">Useful answers</p>
          <h2 class="mt-3 text-3xl font-semibold text-brand-900 md:text-4xl">Questions before an alteration</h2>
        </div>
        <div class="divide-y divide-slate-200 border-y border-slate-200">
          {page.faqs.map((faq) => (
            <details class="group py-6">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold text-brand-900">
                <span>{faq.question}</span>
                <span class="text-2xl font-normal text-brand-600 transition-transform group-open:rotate-45" aria-hidden="true">
                  +
                </span>
              </summary>
              <p class="mt-3 max-w-2xl leading-7 text-slate-700">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-brand-900 py-14 text-white md:py-20">
      <div class="container-page flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-sm font-semibold text-blue-200">Visit the atelier</p>
          <h2 class="mt-3 max-w-2xl text-3xl font-semibold md:text-4xl">Bring the garment. We will talk through the options.</h2>
          <p class="mt-4 max-w-2xl text-blue-50">
            {businessInfo.streetAddress}, {businessInfo.addressLocality}, {businessInfo.postalCode}
          </p>
        </div>
        <a class="inline-flex min-h-12 w-fit items-center rounded-xl bg-white px-5 py-3 font-semibold text-brand-900 hover:bg-blue-50" href="/#contact">
          Contact Koko Atelier
        </a>
      </div>
    </section>

    <section class="section-padding" aria-labelledby="other-services">
      <div class="container-page">
        <h2 id="other-services" class="text-2xl font-semibold text-brand-900">Explore other alteration services</h2>
        <nav class="mt-6 flex flex-wrap gap-x-6 gap-y-3" aria-label="Other services">
          {otherServices.map((service) => (
            <a class="font-semibold text-brand-700 underline decoration-blue-200 underline-offset-4 hover:text-brand-900" href={`/${service.slug}/`}>
              {service.shortName}
            </a>
          ))}
        </nav>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
